APP_ORIGIN=http://localhost:3000
APP_SECRET=

# Firebase Web App config (public identifiers, not admin credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Local-only Auth emulator, for example 127.0.0.1:9099. Leave blank otherwise.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_RULES_CONFIRMED=false

FIREBASE_PROJECT_ID=
# Local: point GOOGLE_APPLICATION_CREDENTIALS to a protected service-account file.
# Google Cloud: use ADC/workload identity and set this to true.
FIREBASE_USE_ADC=false
GOOGLE_APPLICATION_CREDENTIALS=
# Optional alternative to GOOGLE_APPLICATION_CREDENTIALS. Never commit a real value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Used only by scripts/bootstrap-owner.mjs after offline identity verification.
OWNER_BOOTSTRAP_USERNAME=
